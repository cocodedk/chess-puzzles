    <!-- The About screen: the section titles follow the cocode-apps standard, in this order. -->
    <string name="about">درباره</string>
    <string name="about_back">بازگشت</string>
    <string name="about_version">نسخه %1$s</string>
    <string name="about_check_updates">دیدن آخرین نسخه</string>
    <string name="about_check_updates_note">صفحه‌ی همین برنامه را باز می‌کند؛ آخرین نسخه همان‌جا منتشر می‌شود. خود برنامه هیچ‌وقت به‌روزرسانی را بررسی نمی‌کند.</string>
    <string name="about_section_what">برنامه چه کار می‌کند</string>
    <string name="about_what">برنامه‌ی Chess Puzzles به شما کمک می‌کند تاکتیک‌های شطرنج را تمرین کنید. هر معما از پایگاه‌داده‌ی معماهای Lichess می‌آید، می‌گوید چه چیزی را باید پیدا کنید (مثلاً مات در ۲ حرکت) و ریتینگی دارد که سختی‌اش را نشان می‌دهد. می‌توانید گشایش‌های رایج را هم حرکت‌به‌حرکت یاد بگیرید و بعد از حفظ بازی کنید. همه‌چیز روی گوشی شما ذخیره می‌شود، پس برنامه بدون اینترنت کار می‌کند.</string>
    <string name="about_section_privacy">حریم خصوصی</string>
    <string name="about_privacy_no_data">برنامه‌ی Chess Puzzles هیچ اطلاعات شخصی‌ای را جمع نمی‌کند، نمی‌فرستد و به اشتراک نمی‌گذارد.</string>
    <string name="about_privacy_no_permissions">هیچ‌وقت از شما مجوزی نمی‌خواهد و نمی‌تواند از اینترنت استفاده کند.</string>
    <string name="about_privacy_no_tracking">بدون حساب کاربری، بدون تبلیغات، بدون ابزار آمارگیری و بدون گزارش خرابی.</string>
    <string name="about_privacy_on_device">پیشرفت شما روی گوشی ذخیره می‌شود. خود برنامه آن را هیچ‌جا نمی‌فرستد.</string>
