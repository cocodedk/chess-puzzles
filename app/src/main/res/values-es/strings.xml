    <string name="about_check_updates_note">Abre la página de la app, donde se publica la versión más reciente. La app nunca busca actualizaciones por sí sola.</string>
    <string name="about_section_what">Qué hace la app</string>
    <string name="about_what">Chess Puzzles te ayuda a practicar tácticas de ajedrez. Cada puzle procede de la base de datos de puzles de Lichess, te dice qué debes encontrar (por ejemplo, jaque mate en 2) y tiene un rating que indica lo difícil que es. También puedes aprender las aperturas más habituales jugada a jugada y luego jugarlas de memoria. Todo se guarda en tu teléfono, así que la app funciona sin internet.</string>
    <string name="about_section_privacy">Privacidad</string>
    <string name="about_privacy_no_data">Chess Puzzles no recoge, envía ni comparte ningún dato personal.</string>
    <string name="about_privacy_no_permissions">Nunca te pide ningún permiso y no puede usar internet.</string>
    <string name="about_privacy_no_tracking">Sin cuenta, sin anuncios, sin analíticas y sin informes de fallos.</string>
    <string name="about_privacy_on_device">Tu progreso se guarda en tu teléfono. La app nunca lo envía a ningún sitio.</string>
    <string name="about_privacy_link">Leer la política de privacidad</string>
